#!/bin/sh
# Runs the full local check suite (fmt, vet, build, race tests,
# staticcheck, golangci-lint, govulncheck, fuzz smoke) before every
# commit — the same set `make check` runs. See .githooks/README.md to
# enable/disable, or `git commit --no-verify` to skip once deliberately.
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: running 'make check' (fmt, vet, build, race tests, staticcheck, lint, govulncheck, fuzz)..."
make check

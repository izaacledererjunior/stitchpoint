# Copy to .env (not committed — see .gitignore) and fill in.

# The domain pointed at this instance's IP (A record) for the API, e.g. api.example.com
DOMAIN=

# The domain (separate A record, same IP) for the stitchpoint-playground
# frontend, e.g. playground.example.com
FRONTEND_DOMAIN=

# CORS origin for the frontend above — must match it exactly
# (https://<FRONTEND_DOMAIN>), so only that origin can call this API from
# a browser. Leave unset (defaults to "*") only temporarily, before the
# frontend has a real domain — there's no cookie/auth to leak either way,
# but there's no reason to leave it open once a real value exists.
ALLOWED_ORIGIN=
